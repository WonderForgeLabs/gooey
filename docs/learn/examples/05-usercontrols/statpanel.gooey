<Gooey xmlns="wonderforge.io/gooey/2026">
  <Border Title="{{.Title}}" Style="panel">
    <VStack Gap="1">
      <Text Style="accent">{{.Reading}}</Text>
      <HStack Gap="2">
        <Button Content="+1" Click="{{.Up}}"/>
        <Button Content="-1" Click="{{.Down}}"/>
      </HStack>
      <Text Style="dim">{{.Note}}</Text>
    </VStack>
  </Border>
</Gooey>
