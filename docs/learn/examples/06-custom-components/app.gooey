<Gooey xmlns="wonderforge.io/gooey/2026">
  <Border Title="custom components" Style="panel">
    <VStack Gap="1">
      <Text Style="dim">Meter — no focus, no input: it only paints what it reads</Text>
      <Meter Value="{{.Level}}" Max="20" Width="44"/>

      <Text Style="dim">Stepper — a focus stop: left/right adjust it, a click focuses it</Text>
      <Stepper Value="{{.Level}}" Label="level  (drives the meter above)"/>
      <Stepper Value="{{.Other}}" Label="other  (nothing else reads it)"/>

      <Text Style="accent">{{.Readout}}</Text>
      <Text Style="dim">tab / shift+tab: focus    left / right: adjust    q: quit</Text>
    </VStack>

    <KeyBinding Gesture="q" Command="{{.Quit}}"/>
    <KeyBinding Gesture="ctrl+c" Command="{{.Quit}}"/>
  </Border>
</Gooey>
