<Gooey xmlns="wonderforge.io/gooey/2026">
  <!-- The whole page is styled by ONE property. Style="{{.Accent}}" is a
       live handle onto a computed that reads the picked color, so moving
       a channel in the picker restyles the border, the title, and the
       cascade below through the property graph — no theme system, no
       "apply style" call anywhere. -->
  <!-- Background makes the page a filled surface: the framework paints
       the fill, leaves pre-clear against it, and a Border repaint
       z-orders its subtree back on top. -->
  <Border Title="gooey — color" Style="{{.AccentStyle}}" Background="#12121e">
    <Grid Rows="Auto,*,Auto">
      <Text Grid.Row="0" Style="{{.AccentStyle}}">
        arrows: ←/→ adjust  ↑/↓ channel  shift: ×16  home/end: 0/255  •  click or scroll a bar  •  q: quit
      </Text>

      <!-- Canvas: absolute positioning. Everything below is placed by
           Canvas.Left/Canvas.Top rather than by a stack or a grid, which
           is what lets the swatch cascade overlap on purpose. -->
      <Canvas Grid.Row="1">
        <ColorPicker Value="{{.Accent}}" Canvas.Left="1" Canvas.Top="1"/>

        <Text Canvas.Left="1" Canvas.Top="7" Style="dim">tier simulation — what each terminal class shows</Text>
        <TierStrip Canvas.Left="1" Canvas.Top="8"/>

        <!-- Stacked cards, and a real overlap: each swatch is 10 cells
             wide and 2 rows tall, stepping 4 right and 1 down, so every
             card shares 6 cells of its lower row with the next one.
             Tree order IS z-order for ordinary siblings — the later one
             paints on top. (An overlay is the exception: it is lifted
             out of that order entirely. Nothing here is one.)

             The card itself is swatch.gooey, a markup-only control: the
             five instances differ only in a bound tint and a position,
             which is exactly what an <Include> is for. Placement stays
             on the INSTANCE — Canvas.Left/Top are the element's, not the
             control's, so a control never has to declare them. -->
        <Swatch Tint="{{.Tint0}}" Canvas.Left="46" Canvas.Top="1"/>
        <Swatch Tint="{{.Tint1}}" Canvas.Left="50" Canvas.Top="2"/>
        <Swatch Tint="{{.Tint2}}" Canvas.Left="54" Canvas.Top="3"/>
        <Swatch Tint="{{.Tint3}}" Canvas.Left="58" Canvas.Top="4"/>
        <Swatch Tint="{{.Tint4}}" Canvas.Left="62" Canvas.Top="5"/>
        <Text Canvas.Left="46" Canvas.Top="0" Style="dim">overlapping cascade, placed by Canvas.Left/Top</Text>
      </Canvas>

      <Text Grid.Row="2" Style="dim">{{.Status}}</Text>

      <KeyBinding Gesture="q" Command="{{.Quit}}"/>
      <KeyBinding Gesture="ctrl+c" Command="{{.Quit}}"/>
    </Grid>
  </Border>
</Gooey>
