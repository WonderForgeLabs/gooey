<Gooey xmlns="wonderforge.io/gooey/2026">
  <Border Title="finder" Style="panel">
    <Grid Rows="Auto,Auto,*" Cols="3*,2*">
      <TextBox Grid.Row="0" Grid.ColSpan="2" Name="query"
               Text="{{.Query}}" Prompt="&gt; " Style="input"
               AccentStyle="accent" Changed="{{.ResetSelection}}"/>
      <Text    Grid.Row="1" Grid.ColSpan="2" Style="dim">{{.Status}}</Text>

      <!-- The results are an ItemsView with Focusable="false": fzf-style,
           the query line is the ONLY focus stop, so a click selects a row
           (hit-testing needs no focus) and typing never goes dead. The
           match-highlight cell is this demo's own component, placed BY
           the template. -->
      <ItemsView Grid.Row="2" Grid.Col="0" Name="results"
                 Items="{{.Rows}}" Selected="{{.Selection}}" Focusable="false">
        <ItemsView.ItemTemplate>
          <MatchLine Path="{{.Path}}" Hits="{{.Hits}}"/>
        </ItemsView.ItemTemplate>
      </ItemsView>
      <Preview Grid.Row="2" Grid.Col="1" Margin="2,0,0,0" Lines="{{.Preview}}"/>

      <!-- Page-level gestures. With the query line the only focus stop
           they are effectively global: every list gesture lands here
           after the TextBox declines it. -->
      <KeyBinding Gesture="enter"    Command="{{.Accept}}"/>
      <KeyBinding Gesture="esc"      Command="{{.Quit}}"/>
      <KeyBinding Gesture="ctrl+c"   Command="{{.Quit}}"/>
      <KeyBinding Gesture="up"       Command="{{.SelectPrev}}"/>
      <KeyBinding Gesture="down"     Command="{{.SelectNext}}"/>
      <KeyBinding Gesture="ctrl+p"   Command="{{.SelectPrev}}"/>
      <KeyBinding Gesture="ctrl+n"   Command="{{.SelectNext}}"/>
      <KeyBinding Gesture="pageup"   Command="{{.SelectPageUp}}"/>
      <KeyBinding Gesture="pagedown" Command="{{.SelectPageDown}}"/>
    </Grid>
  </Border>
</Gooey>
