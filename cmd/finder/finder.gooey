<Gooey xmlns="wonderforge.io/gooey/2026">
  <Border Title="finder" Style="panel">
    <Grid Rows="Auto,Auto,*" Cols="3*,2*">
      <TextBox Grid.Row="0" Grid.ColSpan="2" Name="query"
               Text="{{.Query}}" Prompt="&gt; " Style="input"
               AccentStyle="accent" Changed="{{.ResetSelection}}"/>
      <Text    Grid.Row="1" Grid.ColSpan="2" Style="dim">{{.Status}}</Text>
      <Results Grid.Row="2" Grid.Col="0"/>
      <Preview Grid.Row="2" Grid.Col="1" Margin="2,0,0,0"/>

      <!-- Page-level gestures. They sit above both focus stops, so
           dispatch reaches them only after the focused component declined
           the key: ↑/↓ land here while the query line has focus, and are
           consumed by the results pane while it does. -->
      <KeyBinding Gesture="enter"  Command="{{.Accept}}"/>
      <KeyBinding Gesture="esc"    Command="{{.Quit}}"/>
      <KeyBinding Gesture="ctrl+c" Command="{{.Quit}}"/>
      <KeyBinding Gesture="up"     Command="{{.SelectPrev}}"/>
      <KeyBinding Gesture="down"   Command="{{.SelectNext}}"/>
      <KeyBinding Gesture="ctrl+p" Command="{{.SelectPrev}}"/>
      <KeyBinding Gesture="ctrl+n" Command="{{.SelectNext}}"/>
    </Grid>
  </Border>
</Gooey>
