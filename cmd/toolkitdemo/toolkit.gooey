<Gooey xmlns="wonderforge.io/gooey/2026">
  <Border Title="toolkit — waves 1+2" Style="panel">
    <Grid Rows="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
      <Text Grid.Row="1" Style="accent">eight components, one page, all of it markup</Text>

      <Text Grid.Row="2" Style="dim">ProgressBar — determinate, and indeterminate when the rocker below stops the job</Text>
      <HStack Grid.Row="3" Gap="3">
        <ProgressBar Value="{{.Pct}}" Indeterminate="{{.Busy}}" Label="build " BarWidth="34"/>
        <Spinner Frames="braille" Interval="90ms" Label="{{.Stage}}" Enabled="{{.Running}}" Style="accent"/>
      </HStack>

      <Text Grid.Row="4" Style="dim">Toggle — a rocker: space flips it, ← is off, → is on. Segmented — ←/→ pick a mode.</Text>
      <HStack Grid.Row="5" Gap="4">
        <Toggle Checked="{{.Running}}" Label="job running"/>
        <Segmented Options="Idle | Fetch | Build | Deploy" Selected="{{.StageIndex}}" Changed="{{.StageChanged}}"/>
      </HStack>

      <Text Grid.Row="6" Style="dim">ButtonBar — ←/→ walk along the bar and wrap; "toast" pops a notification</Text>
      <ButtonBar Grid.Row="7" Gap="3" Uniform="true" Separator="│">
        <Button Content="start" Click="{{.Start}}"/>
        <Button Content="abort" Click="{{.Abort}}"/>
        <Button Content="reset all" Click="{{.Reset}}"/>
        <Button Content="toast" Click="{{.Notify}}"/>
      </ButtonBar>

      <Text Grid.Row="8" Style="dim">Button Chrome="pixel" — a three-row pill, drawn in pixels where the terminal has a protocol</Text>
      <HStack Grid.Row="9" Gap="3">
        <Button Content="Deploy" Chrome="pixel" Click="{{.Deploy}}"/>
        <Text Style="dim" VAlign="Center">{{.Tier}}</Text>
      </HStack>

      <Text Grid.Row="10" Style="dim">{{.Log}}</Text>

      <StatusBar Grid.Row="11" Left="{{.Status}}" Center="{{.Clock}}">
        <StatusBar.Right>
          <Text Style="dim">tab: focus   enter: open menu   esc: close   q: quit</Text>
        </StatusBar.Right>
      </StatusBar>

      <Timer Interval="120ms" Tick="{{.Advance}}"/>
      <Timer Interval="1s" Tick="{{.TickClock}}"/>
      <KeyBinding Gesture="q" Command="{{.Quit}}"/>
      <KeyBinding Gesture="ctrl+c" Command="{{.Quit}}"/>
      <KeyBinding Gesture="ctrl+s" Command="{{.Start}}"/>
      <KeyBinding Gesture="ctrl+x" Command="{{.Abort}}"/>
      <KeyBinding Gesture="ctrl+r" Command="{{.Reset}}"/>
      <KeyBinding Gesture="ctrl+t" Command="{{.Notify}}"/>

      <!-- Wave 2: overlays. Document order is z-order, so the MenuBar and
           the toast layer are declared LAST — the dropdown and the toasts
           paint above the rows they cover — while Grid.Row still places
           the bar on the top row. -->
      <MenuBar Grid.Row="0" Style="accent">
        <Menu Title="Job">
          <MenuItem Text="Start" Gesture="ctrl+s" Command="{{.Start}}"/>
          <MenuItem Text="Abort" Gesture="ctrl+x" Command="{{.Abort}}"/>
          <MenuItem Text="Reset" Gesture="ctrl+r" Command="{{.Reset}}"/>
          <MenuItem Separator="true"/>
          <MenuItem Text="Quit" Gesture="q" Command="{{.Quit}}"/>
        </Menu>
        <Menu Title="Notify">
          <MenuItem Text="Toast the status" Gesture="ctrl+t" Command="{{.Notify}}"/>
        </Menu>
      </MenuBar>
      <ToastHost Name="Toasts" Grid.Row="0" Grid.RowSpan="12" Duration="2500ms"/>
    </Grid>
  </Border>
</Gooey>
