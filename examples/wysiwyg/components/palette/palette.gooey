<Gooey xmlns="wonderforge.io/gooey/2026"
       xmlns:x="wonderforge.io/gooey/x">

  <!-- The pane's public surface. Declaring it at all makes the control
       STRICT: an attribute the shell writes and this file does not
       declare is a load error rather than a silently ignored binding.
       That is the whole reason the panes are controls instead of inline
       markup — four panes reading one *editor struct declared nothing,
       so nothing could be checked. -->
  <x:Property Name="Items"    Type="any" Required="true"/>
  <x:Property Name="Sel"      Type="int" Required="true"/>
  <x:Property Name="Activate" Type="any" Required="true"/>

  <!-- The Border is the pane's own chrome, and it is also what keeps the
       pane transparent to patch_markup: control.childSlot type-switches
       on six concrete containers and *components.Border is one of them,
       so a name declared inside this file is still a reachable patch
       address. A pane whose root were a custom Go type would not be. -->
  <Border Title="palette (from Catalog)">
    <ItemsView Items="{{.Items}}" Selected="{{.Sel}}" Activate="{{.Activate}}">
      <ItemsView.ItemTemplate>
        <HStack Gap="1">
          <Text Width="16">{{.Name}}</Text>
          <!-- The honesty column: "none" and "? unknown" are different
               facts about the app and must not render alike.
               Width is 9 because "? unknown" is 9 cells. At 8 it rendered
               "? unknow", which is the column's own point delivered as
               what looks like a rendering fault — found by the render
               test, invisible to every contract test above. -->
          <Text Width="9" Style="dim">{{.Attrs}}</Text>
          <Text Style="dim">{{.Kids}}</Text>
        </HStack>
      </ItemsView.ItemTemplate>
    </ItemsView>
  </Border>
</Gooey>
