<Gooey xmlns="wonderforge.io/gooey/2026"
       xmlns:x="wonderforge.io/gooey/x">

  <!-- Both are Type="string" rather than "any": the shell binds
       *prop.Property[string] handles, and a declared string checks that
       at load. "any" would accept anything and report nothing. -->
  <x:Property Name="Tree"   Type="string" Required="true"/>
  <x:Property Name="Source" Type="string" Required="true"/>

  <Border Title="markup">
    <VStack>
      <!-- The outline, with the selection marker, above the emitted
           source. Two views of one document: the tree is what the editor
           addresses, the source is what it would write. -->
      <Text>{{.Tree}}</Text>
      <Text Style="dim">{{.Source}}</Text>
    </VStack>
  </Border>
</Gooey>
