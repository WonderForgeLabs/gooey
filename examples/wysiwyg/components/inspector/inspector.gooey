<Gooey xmlns="wonderforge.io/gooey/2026"
       xmlns:x="wonderforge.io/gooey/x">

  <x:Property Name="Items"     Type="any"    Required="true"/>
  <x:Property Name="Sel"       Type="int"    Required="true"/>
  <x:Property Name="Activate"  Type="any"    Required="true"/>
  <x:Property Name="EditName"  Type="string" Required="true"/>
  <x:Property Name="EditValue" Type="string" Required="true"/>
  <x:Property Name="Commit"    Type="any"    Required="true"/>
  <x:Property Name="Doc"       Type="string" Required="true"/>

  <!-- THE INPUT LIVES HERE, and that is a structural claim rather than a
       layout choice. The preview subtree is discarded and rebuilt on
       every edit; replacing a subtree resets component-local state, and a
       caret is component-local. So the editor's own TextBox must never be
       a descendant of the preview. Moving this pane inside the preview —
       or the preview host inside this file — reintroduces the defect
       where the user's next character lands in the middle of their own
       text. TestEditorInputsAreSiblingsOfThePreview is what fails if it
       happens. -->
  <Border Title="inspector (AttrsFor)">
    <VStack>
      <ItemsView Items="{{.Items}}" Selected="{{.Sel}}" Activate="{{.Activate}}" Height="7">
        <!-- Mark is the modified-from-default column: "•" where the
             document's value differs from AttrSpec.Default, blank where
             it does not or where no default is declared. Rows arrive
             grouped by markup.CategoryOf, so this is the categorised view
             without header rows to complicate the selection index. -->
        <ItemsView.ItemTemplate>
          <HStack Gap="1">
            <Text Width="1" Style="sel">{{.Mark}}</Text>
            <Text Width="13">{{.Name}}</Text>
            <Text Width="7" Style="dim">{{.Kind}}</Text>
            <Text Width="13" Style="dim">{{.Legal}}</Text>
            <Text Style="ok">{{.Value}}</Text>
          </HStack>
        </ItemsView.ItemTemplate>
      </ItemsView>
      <HStack Gap="1">
        <Text Width="14" Style="sel">{{.EditName}}</Text>
        <TextBox Text="{{.EditValue}}" Changed="{{.Commit}}"/>
      </HStack>
      <!-- The description pane. AttrSpec.Doc is empty everywhere today,
           so the editor sends the legal values instead and will send
           prose the moment Doc is populated — wired now so that becomes
           data entry rather than plumbing. -->
      <Text Style="dim">{{.Doc}}</Text>
    </VStack>
  </Border>
</Gooey>
