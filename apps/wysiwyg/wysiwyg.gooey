<Gooey xmlns="wonderforge.io/gooey/2026">
  <!-- The IDE shell.

       ┌──────────────────────────────────────────────┐
       │ MENU BAR  File  Project  View                │
       ├──┬───────────┬──────────────────┬────────────┤
       │A │ LEFT SLOT │  CENTER SLOT     │ RIGHT SLOT │
       │c │           │  (design | code) │            │
       │t ├───────────┴──────────────────┴────────────┤
       │  │ BOTTOM SLOT                               │
       ├──┴───────────────────────────────────────────┤
       │ STATUS BAR                                   │
       └──────────────────────────────────────────────┘

       THE FOUR PANES ARE NO LONGER IN FOUR GRID CELLS, and that is the
       whole change. A `<Grid Cols="4,38,1*,46">` puts each pane in a
       fixed track, and a track list is not state: `[]GridLen` is a plain
       field read during Arrange, so nothing observes it and nothing can
       move a pane without rewriting this file. Every dock operation a
       user expects — move this to the other side, collapse it, get it
       out of the way — was an edit to that attribute string.

       So the client area is one `<DockHost>` and the panes DECLARE where
       they start rather than where they live. Slot, order, size, pinned,
       collapsed and hidden are model state from the first frame on; the
       markup seeds it and the keyboard moves it. See dock.go.

       WHAT IS STILL A GRID, and correctly: the three rows around the
       dock. The menu bar, the client area and the status bar do not
       move, so a declared track list is exactly right for them. The rule
       is not "grids are bad", it is "a track list cannot express a
       layout the user rearranges".

       THE MENU BAR IS THE LAST CHILD, on purpose. Z-order in gooey IS
       document order, and the dropdown must paint above the panes it
       covers; Grid.Row and element order are independent, which is what
       lets it be declared last and drawn first. -->
  <Grid Name="Page" Rows="1,1*,1" Cols="5,1*">

    <!-- KeyBindings live on the ROOT. A binding only fires while the
         focused chain passes through its host, so a page whose focus can
         sit anywhere needs its global gestures where every event passes. -->
    <KeyBinding Gesture="q" Command="{{.Quit}}"/>
    <KeyBinding Gesture="ctrl+c" Command="{{.Quit}}"/>
    <KeyBinding Gesture="x" Command="{{.Delete}}"/>
    <KeyBinding Gesture="ctrl+n" Command="{{.NextEl}}"/>
    <KeyBinding Gesture="ctrl+p" Command="{{.PrevEl}}"/>
    <!-- MOVE, on hjkl. Not arrows: an unclaimed arrow falls through to
         focus navigation, so binding a bare arrow here would take
         tab-order movement away from the panes, and ctrl+arrow is the
         dock cluster further down.

         ALT, NOT CTRL, and that is a fix rather than a preference.
         Half this cluster never fired: ctrl+h is the byte 0x08 and
         ctrl+j is 0x0a, which the decoder reads as backspace and enter
         — the right calls, since that is what people mean by those
         keys, but it left MoveDown and Promote bound to gestures no
         terminal can send. ctrl+k and ctrl+l worked, so the cluster was
         half alive and looked whole. input.ParseGesture rejects the
         dead spellings now (issue #427), which is what turned a silent
         nothing into a load error; moving all four rather than the two
         keeps hjkl one cluster.

         alt+<letter> SHADOWS A MENU MNEMONIC, so check the menu bar
         before adding to this list: a root KeyBinding is offered the
         key before the mnemonics are, and the menu titles are File,
         Project and View. A _Help menu would collide with alt+h and the
         menu would be the one that lost. -->
    <KeyBinding Gesture="alt+k" Command="{{.MoveUp}}"/>
    <KeyBinding Gesture="alt+j" Command="{{.MoveDown}}"/>
    <KeyBinding Gesture="alt+h" Command="{{.Promote}}"/>
    <KeyBinding Gesture="alt+l" Command="{{.Demote}}"/>
    <KeyBinding Gesture="ctrl+d" Command="{{.Duplicate}}"/>

    <!-- COPY / CUT / PASTE. See clipboard.go for why these are three
         gestures and not four: `y` writes BOTH clipboards (the subtree
         internally, its markup to the terminal via OSC 52), because
         there is no version of "copy" where the user wants one and not
         the other, and no way to ask them which.

         There is deliberately NO key that READS the system clipboard.
         OSC 52 reads are refused by most terminals, so such a key would
         do nothing and have no way to say so. Markup pastes IN through
         the terminal's own paste key, which arrives as one
         input.EventPaste because bracketed paste is on — see
         input/paste.go.

         `ctrl+x` rather than bare `x`, which is already Delete. The
         distinction is real and worth a modifier: delete drops the
         subtree, cut keeps it. -->
    <KeyBinding Gesture="y" Command="{{.Copy}}"/>
    <KeyBinding Gesture="ctrl+x" Command="{{.Cut}}"/>
    <KeyBinding Gesture="p" Command="{{.Paste}}"/>

    <!-- THE CONTROL-PLANE ADDRESSES, from the keyboard. The status bar's
         chips are clickable, but mouse reports cannot be injected through
         a recording pty, so a click-only affordance is one that can never
         be captured or verified — every feature here stays keyboard-
         operable for the same reason esc-selects-parent does.

         ctrl+g is grpc and ctrl+t is the MCP URL (t for tools). ctrl+u
         and ctrl+e were the first choices and both collided with the
         dock work — nothing reports a duplicate gesture, the loser just
         never fires. The MENU has no global key at all: it opens with a
         bare `m` while the strip is focused, which keeps a context menu
         out of a page-wide budget that is nearly spent. NOT ctrl+m for
         MCP, however obvious: that byte is 0x0d, indistinguishable from
         Enter on the wire. See statusaddr.go for the other two decode
         traps (F-keys never decode; ctrl+shift+X collapses to ctrl+X).

         On the ROOT with the others, and for the same reason: a binding
         only fires while the focused chain passes through its host. See
         copyEndpoint in statusaddr.go. -->
    <KeyBinding Gesture="ctrl+g" Command="{{.CopyGrpc}}"/>
    <KeyBinding Gesture="ctrl+t" Command="{{.CopyMCP}}"/>

    <!-- UNDO AND REDO, over the document model.

         CTRL+Z IS FREE TO TAKE HERE, and that is checked rather than
         assumed: term.MakeRaw clears ISIG, so while a gooey app holds
         the terminal the tty driver generates no SIGTSTP from it — the
         byte 0x1a arrives like any other and input.Decode makes an
         ordinary ctrl+z KeyEvent out of it. Nothing in this app bound it
         before, so it was being dropped. App.Suspend and the SIGTSTP
         dance in signals_unix.go are both untouched; a `kill -TSTP` from
         outside still suspends the editor exactly as it did.

         REDO IS ctrl+y AND NOT ALSO ctrl+shift+z. A terminal cannot
         report shift on a printable character, so ctrl+shift+z is the
         SAME byte as ctrl+z and the decoder lower-cases it on purpose.
         ParseGesture folds the shift into the rune and ctrl lower-cases
         it back, so a ctrl+shift+z binding is not a second gesture — it
         is a DUPLICATE of the ctrl+z one above, and two bindings on one
         gesture means one of them silently never fires. Adding it as a
         kindness would put a live candidate in front of UNDO. See
         undo.go and TestCtrlShiftZIsAnALIASForCtrlZAndSoIsNotBoundToRedo. -->
    <KeyBinding Gesture="ctrl+z" Command="{{.Undo}}"/>
    <KeyBinding Gesture="ctrl+y" Command="{{.Redo}}"/>

    <!-- ESC SELECTS THE PARENT, which is Microsoft's spelling rather than
         one invented here: "To select the parent of a current selection in
         the designer, press the ESC key" is the WPF designer's own
         documentation, and Blend inherits it. It is the way back OUT of a
         container a double-click drilled into, and without it a shallow-
         first designer is a one-way door.

         It is the keyboard's whole share of the drill gesture. Everything
         here has to stay keyboard-operable because mouse reports cannot be
         injected through a recording pty at all, so a double-click that
         could only be undone with another double-click could never be
         captured. -->
    <KeyBinding Gesture="esc" Command="{{.SelectParent}}"/>
    <!-- ALT+ENTER IS THE INVERSE OF ESC, and it is the ONLY way to
         select a node that builds no component: a <Menu> or <MenuItem>
         is drawn by <MenuBar> out of data, so nothing under the pointer
         belongs to it and the double-click drill cannot reach one. See
         selectChild.

         ALT+ENTER RATHER THAN ENTER, and both halves of that were
         measured rather than preferred.

         Bare enter is gone before it gets here. The bubble offers a
         node's own handlers before its ancestors' KeyBindings, and
         enter is the toolbox's Activate, the inspector's row editor and
         every caret editor's commit — there is no focus position in
         this app where a root enter would fire.

         Scoping it to the design pane instead was the obvious fix and
         does not work: *preview.Pane is not in the focus order (it is a
         gooey.Frozen HOST, which is why presses are retargeted to it
         rather than routed through it), so nothing focused ever passes
         through that subtree and a binding hosted there can never fire.
         TestEnterDescendsIntoTheMenuVocabulary asserts the gesture
         through this binding, so a move back to either shape fails
         rather than going quiet.

         The alt prefix is safe here where alt+<letter> would not be: a
         root binding is offered the key before the menu mnemonics are,
         and enter is not a letter any menu title can carry. -->
    <KeyBinding Gesture="alt+enter" Command="{{.SelectChild}}"/>
    <KeyBinding Gesture="d" Command="{{.ToggleMode}}"/>
    <!-- The theme switch, and today it moves exactly one thing: the
         tint the toolbox's icons are rasterized in. That is a small
         effect with a precise contract — the flip repaints the icons
         and NOTHING else, which
         TestThemeFlipRepaintsOnlyTheToolboxIcons counts rather than
         eyeballs. A theme that repainted the tree would be a theme that
         had quietly stopped being a property. -->
    <KeyBinding Gesture="t" Command="{{.ToggleTheme}}"/>

    <!-- THE DOCK GESTURES, and every one of them exists because a
         pointer-only dock cannot be verified AT ALL: mouse reports
         cannot be injected through a recording pty, so a pane that can
         only be moved by dragging is a pane no test can move.

         The mouse path is real too — press a pane header and drag — but
         it is the second implementation of these same six model methods,
         never the only one. -->

    <!-- Which pane the dock gestures act on. -->
    <KeyBinding Gesture="ctrl+alt+right" Command="{{.NextPane}}"/>
    <KeyBinding Gesture="ctrl+alt+left" Command="{{.PrevPane}}"/>

    <!-- DRAG TO POSITION, from the keyboard: dock the active pane into
         the slot the arrow points at. ctrl+up is the CENTRE rather than
         a fourth edge, because the centre is the slot the others crowd
         and it needs a way back. -->
    <KeyBinding Gesture="ctrl+left" Command="{{.DockLeft}}"/>
    <KeyBinding Gesture="ctrl+right" Command="{{.DockRight}}"/>
    <KeyBinding Gesture="ctrl+up" Command="{{.DockCenter}}"/>
    <KeyBinding Gesture="ctrl+down" Command="{{.DockBottom}}"/>

    <!-- Order within a slot, and the slot's size. -->
    <KeyBinding Gesture="alt+up" Command="{{.PaneUp}}"/>
    <KeyBinding Gesture="alt+down" Command="{{.PaneDown}}"/>
    <KeyBinding Gesture="shift+up" Command="{{.Grow}}"/>
    <KeyBinding Gesture="shift+down" Command="{{.Shrink}}"/>

    <!-- HIDE, COLLAPSE and PIN are three operations, not three names for
         one. ctrl+w hides — the pane stops showing and KEEPS ITS SIZE
         and its subtree, which is gooey.Hidden. ctrl+r collapses — the
         pane shrinks to its header row and its slot-mates take the
         space. ctrl+alt+p pins, which changes nothing on its own and
         decides what ctrl+f spares.

         Both of those gestures MOVED, and the two comments below say why
         — read them rather than this line, which is the summary. This
         one named ctrl+k and ctrl+u until a review caught it: the
         collision notes were updated and the summary six lines above
         them was not, so the file's own comments disagreed about the
         keymap two ways to one. -->
    <KeyBinding Gesture="ctrl+w" Command="{{.TogglePane}}"/>
    <KeyBinding Gesture="ctrl+r" Command="{{.CollapsePane}}"/>
    <!-- ctrl+alt+p, and it has now dodged TWO collisions of different
         kinds. Not ctrl+k: that WAS MoveUp, the designer's move gesture
         that landed in #373 while this pane was held. MoveUp is alt+k
         now (#427 moved the cluster off the gestures no terminal can
         send), so the collision this paragraph dodged no longer exists —
         it is kept because the REASONING is what matters here and it
         still applies to whatever lands on ctrl+alt+p next. Two KeyBindings on
         one gesture at the same host is not a load error: both are scoped
         to the root, dispatch offers them in order, and the loser simply
         never fires. So the collision would have shipped as "pin silently
         stopped working", with nothing red anywhere. The designer's
         gesture is the one already in users' hands, so pin moved.

         And not the plain alt+p it moved to either, which was worse,
         because the loser was not this binding. p is the _Project menu's
         mnemonic, and FocusManager.Dispatch runs the WHOLE KeyBinding
         bubble before it offers a key to any MnemonicHandler — a
         root-scoped binding is in every focused chain, so alt+p would
         have pinned a pane and the Project menu could never be opened
         from the keyboard again. The rule was already written six lines
         below this one, against alt+e; it just was not applied here.

         ctrl+alt+p is outside mnemonic territory by construction rather
         than by luck: MenuBar.HandleMnemonic tests `ev.Mods !=
         input.ModAlt` — exact equality — so ModCtrl|ModAlt never reaches
         a title. It also keeps p for "pin", and matches the
         ctrl+alt+left/right the pane family already uses. -->
    <KeyBinding Gesture="ctrl+alt+p" Command="{{.PinPane}}"/>
    <!-- ctrl+f, not the ctrl+u this originally used: the status bar's
         endpoint chips took ctrl+u for "copy the MCP URL". Two root
         KeyBindings on one gesture is a SILENT bug — dispatch takes the
         first and the second never fires, with no error anywhere — so
         the collision is resolved here rather than left to be noticed.
         VS Code calls the equivalent Zen Mode; f is for focus. -->
    <KeyBinding Gesture="ctrl+f" Command="{{.HideUnpinned}}"/>
    <KeyBinding Gesture="ctrl+a" Command="{{.ShowAllPanes}}"/>

    <!-- THE REGION SWAP. ctrl+backslash and NOT the ctrl+backtick this
         was specified with, and the difference is not cosmetic: the
         decoder maps control bytes through `c | 0x40`, which covers
         @ A-Z [ \ ] ^ _ and never reaches 0x60, so a ctrl+backtick
         binding PARSES and can never be delivered. input/decode.go calls
         it out by name as an old bug. A dead binding shown as a menu
         hint would be the editor lying about its own keyboard, so the
         nearest key that actually arrives is used instead. -->
    <KeyBinding Gesture="ctrl+\" Command="{{.SwapRegion}}"/>
    <KeyBinding Gesture="ctrl+b" Command="{{.UseBuiltin}}"/>
    <!-- alt+e, not ctrl+e, for the same collision: ctrl+e is the endpoint
         menu. alt+<letter> is MenuBar mnemonic territory, but only for
         letters a menu TITLE wears — File, Project, View take f/p/v — and
         a KeyBinding outranks a mnemonic in dispatch order regardless. -->
    <KeyBinding Gesture="alt+e" Command="{{.UseEditor}}"/>

    <!-- The workspace. -->
    <KeyBinding Gesture="ctrl+o" Command="{{.OpenFolder}}"/>
    <KeyBinding Gesture="ctrl+s" Command="{{.Save}}"/>

    <!-- GRID STRUCTURE, from the keyboard.

         A <Grid> renders as nothing at all, so laying out inside one used
         to mean editing Rows="1,1" against a preview that showed neither
         rows nor columns. The design-time overlay draws the cells and puts
         each track's spec in the gutter beside the space it produces;
         these are the verbs that change it.

         EVERY ONE OF THEM IS A KEY and not only a divider you can drag,
         and that is a testability requirement rather than politeness:
         mouse reports cannot be injected through a recording pty, so a
         resize that only existed as a drag could never be verified in a
         capture.

         [ and ] walk the cursor over every track — columns, then rows,
         then off — so one pair of keys covers both axes and dismissing
         needs no third key. The rest act on the track under the cursor.
         Bare letters are safe for the same reason q, x and d are: these
         bindings are on the ROOT, and a letter typed into a TextBox is
         consumed by that TextBox levels earlier. -->
    <KeyBinding Gesture="]" Command="{{.NextTrack}}"/>
    <KeyBinding Gesture="[" Command="{{.PrevTrack}}"/>
    <KeyBinding Gesture="=" Command="{{.GrowTrack}}"/>
    <KeyBinding Gesture="-" Command="{{.ShrinkTrack}}"/>
    <KeyBinding Gesture="g" Command="{{.CycleTrack}}"/>
    <KeyBinding Gesture="a" Command="{{.AddTrack}}"/>
    <KeyBinding Gesture="r" Command="{{.RemoveTrack}}"/>

    <!-- Drawn in PIXELS, not cells: an icon is a shape, and a terminal
         draws shapes badly out of box-drawing characters. Invisible to
         screen_text, which reads the cell plane. -->
    <ActivityBar Name="ActivityBar" Grid.Row="1" Grid.Col="0" Sel="{{.ActivitySel}}"
                 Margin="0,0,1,0"/>

    <DockHost Name="Dock" Grid.Row="1" Grid.Col="1" Style="dim">

      <!-- EXPLORER — the workspace. A folder you open, not a file the
           binary started with.

           The query box and the list are the FZF SHAPE, and that is a
           deliberate choice against the other one. <TypeAhead> is the
           existing attachment and it is prefix-only by design — the
           type-ahead decision record (docs/specs/2026-08-11-type-ahead-search.md)
           rejects fuzzy inside it on behaviour grounds and names the
           query-box-plus-reranked-list as the OTHER design, a separate
           control rather than a mode. This is that control: it FILTERS
           and RE-RANKS, where TypeAhead moves a selection and never
           hides a row. -->
      <DockPane Id="explorer" Title="EXPLORER" Slot="Left" Size="34">
        <Grid Rows="1,1,1*" Cols="1*">
          <!-- The folder box. There is no modal dialog in this editor, so
               "open folder" focuses a permanent row rather than summoning
               a window that would have to be invented first. -->
          <TextBox Name="PathBox" Grid.Row="0" Text="{{.WsPath}}" Changed="{{.CommitPath}}"/>
          <TextBox Grid.Row="1" Text="{{.WsQuery}}"/>
          <ItemsView Grid.Row="2" Items="{{.WsFiles}}" Selected="{{.WsSel}}"
                     Activate="{{.OpenFile}}">
            <ItemsView.ItemTemplate>
              <HStack Gap="1">
                <Text>{{.Name}}</Text>
              </HStack>
            </ItemsView.ItemTemplate>
          </ItemsView>
        </Grid>
      </DockPane>

      <!-- TOOLS — the palette and the rail's other views. Declared
           UNPINNED so ctrl+f has something to demonstrate on: pin is a
           claim about what survives "get everything out of my way", and
           a dock where every pane is pinned cannot show what pin means.

           SIZE IS SET BY THE TAB STRIP, not by the widest pane content,
           and this is the one number here that a feature can silently
           invalidate. Every component is clipped to its own bounds
           (#409), so a header that does not fit does not spill — it
           VANISHES, and the tab it names becomes reachable only from
           the activity rail with no visible affordance that it exists.
           That is what a fifth tab did: at 34 the strip renders

               | DESIGN | TOOLS | CODE | ISSUES |

           and DOCS is simply absent from the cell plane at every
           terminal size, because this width is a constant.

           40 is the measured minimum for five headers — 38 still drops
           DOCS — and it is measured rather than reasoned so that the
           number cannot be off by the separator arithmetic. The pin is
           TestEveryRailSlotsHeaderReachesTheCellPlane, which reads the
           strip back off a composed frame and checks every railOrder
           header is on it. A sixth tab makes that test red instead of
           shipping an invisible one. -->
      <DockPane Id="tools" Title="TOOLS" Slot="Left" Size="40" Pinned="false">
        <Panel Name="SideBar" Style="dim">
          <Tabs Selected="{{.ActivitySel}}">

          <!-- 0 — DESIGNER. The rail's first icon. There is nothing to put in a
               side bar for it: the designer IS the editor area, and duplicating
               its content here would be two views of one thing competing for the
               selection. So this states that, rather than showing an empty box
               that reads as a failure to load. -->
          <Tab Header="DESIGN">
            <Text Style="dim">The designer is the centre pane.</Text>
          </Tab>

          <!-- 1 — TOOLBOX, the rail's default. -->
          <Tab Header="TOOLS">
          <VStack>
            <!-- ONE COLUMN: the component's name.
                 "COMPONENT", not "ELEMENT" — the toolbox lists things you place,
                 and what you place is a component; "element" is the markup
                 spelling of it, which is the designer's business and not the
                 user's.

                 THE ATTRS AND CHILDREN COLUMNS ARE GONE. They carried real
                 catalog facts — the attribute count, "? unknown" for a
                 registered builder whose schema cannot be enumerated, and the
                 child mode — but a toolbox is a place to pick a component from,
                 not a table to read. Those facts have a better home in the
                 PROPERTIES pane, which is about the one component you selected
                 and has room to say it in words. The honesty rule they existed
                 to make visible still holds in the model and is still pinned by
                 TestPaletteComesFromTheCatalog; what changed is where the UI
                 shows it, and that debt is real until the properties pane
                 carries it. -->
            <HStack Gap="1" Height="1">
              <Text Style="sel">COMPONENT</Text>
            </HStack>
            <ItemsView Name="Toolbox" Items="{{.PaletteItems}}" Selected="{{.PaletteSel}}"
                       Activate="{{.Add}}">
              <ItemsView.ItemTemplate>
                <!-- THREE COLUMNS: selection marker, icon, name.
                     A Grid rather than an HStack because the marker and the
                     icon need FIXED rects that do not move when the name
                     changes width — an icon that shifts column as you scroll
                     reads as a rendering fault.

                     Rows="1" IS LOAD-BEARING. A Grid with no declared rows
                     is one row that takes everything it is offered, so the
                     template measured 29 cells tall and ItemsView realized a
                     SINGLE row for the whole list — a toolbox showing one
                     component, with no error anywhere. The old HStack
                     template measured 1 because a Text does; a Grid does
                     not. -->
                <Grid Rows="1" Cols="1,2,*">
                  <!-- Selection, drawn by the template. Mentioning _selected
                       is what stands the house highlight down, and that is
                       required rather than a preference: the house highlight
                       re-styles the cells a row painted, and over pixel
                       content that is either invisible (a protocol paints
                       ABOVE the cells) or a photo-negative of the icon
                       (halfblock, where the picture IS the cells).
                       cmd/typeahead's album covers reached the same
                       conclusion.

                       The marker's rect is disjoint from the icon's, so a
                       selection hop repaints two Texts and touches no
                       picture. -->
                  <Text Grid.Col="0" Style="sel" Visibility="{{._selected}}">{{.Bar}}</Text>
                  <!-- The icon the CATALOG declares, tinted from a bound
                       handle. Two cells wide and one tall: on a common 10x20
                       cell that is the 20px square toolbox.IconPx
                       rasterizes. An element that declares no icon binds a
                       nil handle and this renders nothing — the honest
                       answer for a registered component whose definition
                       says nothing about how it looks. -->
                  <Image Grid.Col="1" Src="{{.Icon}}" Cols="2" Rows="1"/>
                  <Text Grid.Col="2" Margin="1,0,0,0">{{.Name}}</Text>
                </Grid>
              </ItemsView.ItemTemplate>
            </ItemsView>
          </VStack>
          </Tab>

          <!-- 2 — MARKUP. The document as text, which is the same string the
               OUTPUT tab shows. Deliberately the same binding rather than a
               second copy of the serializer: two views of one document that
               could disagree would be worse than one view. -->
          <Tab Header="CODE">
            <Text Style="dim">{{.Source}}</Text>
          </Tab>

          <!-- 3 — PROBLEMS. FitMsg is what the fit watcher says about the
               current terminal size, and it is empty when everything fits —
               which is why the tab reads as blank most of the time. That is the
               honest state and not a missing view. -->
          <Tab Header="ISSUES">
            <Text Style="dim">{{.FitMsg}}</Text>
          </Tab>

          <!-- 4 — DOCS. The platform's own docs/ tree, inside the editor
               (#288). The list and the page share the side bar because
               the docs are a REFERENCE consulted while building, not a
               thing you edit: putting the page in the centre region
               would make reading the docs and seeing your design
               mutually exclusive, which is the opposite of what a
               reference is for.

               Rows="5,*" rather than two equal halves: the list is for
               finding a page and the page is for reading it, so the
               reader gets whatever is left.

               THE NUMBER IS MEASURED, and it started at 8, which made
               that sentence false. TOOLS shares the LEFT slot with
               EXPLORER and sits above PANEL, so on a 48-row terminal it
               gets ~17 rows and this Grid gets fewer: at Rows="8,*" the
               reader got SIX lines against the list's eight, so
               "whatever is left" was the minority share. Read off a
               composed 160x48 frame, one line of body per row:

                   Rows="8,*" -> 6 body lines
                   Rows="5,*" -> 9
                   Rows="4,*" -> 10

               5 is where the reader has the majority and the list is
               still tall enough to scan. TestTheDocsReaderOutgrowsItsList
               pins the ordering rather than the numbers, which drift
               with every pane above. -->
          <Tab Header="DOCS">
            <Grid Rows="5,*" Cols="*">
              <ItemsView Grid.Row="0" Name="DocsList"
                         Items="{{.DocsItems}}" Selected="{{.DocsSel}}">
                <ItemsView.ItemTemplate>
                  <!-- Same two-column shape the toolbox uses, and the
                       same reason: mentioning _selected stands the house
                       highlight down so the marker is the only thing
                       that moves when the selection does. Two Texts, and
                       a selection hop repaints exactly the two rows that
                       changed. -->
                  <Grid Rows="1" Cols="1,*">
                    <Text Grid.Col="0" Style="sel" Visibility="{{._selected}}">{{.Bar}}</Text>
                    <Text Grid.Col="1" Margin="1,0,0,0">{{.Name}}</Text>
                  </Grid>
                </ItemsView.ItemTemplate>
              </ItemsView>
              <!-- The page. A <Text>, because there is no Markdown
                   component and #288 says ship the cheap version first —
                   a list plus preformatted text answers "where do the
                   docs come from at runtime" without committing to a
                   renderer or the dependency one would cost.

                   AND THEREFORE THE PAGE DOES NOT SCROLL: the whole body
                   goes into one <Text> in a fixed cell, so on a 48-row
                   terminal the first NINE lines of a page are reachable
                   and the rest cannot be reached by any gesture. Nine,
                   measured off a composed frame — not the "roughly 38"
                   this comment used to claim, which was a guess at the
                   terminal's height rather than at this pane's, and was
                   six times too generous about how bad the gap is.
                   Anyone weighing whether #67 can wait should weigh it
                   against nine. That is the consequence of the choice
                   above and it is written here because a reader who hits
                   the bottom of architecture.md has NO WAY TO TELL a
                   truncated pane from a short file — the two look
                   identical.

                   Not an oversight and not cheap to fix. CLIPPING is not
                   what is missing — every component has been clipped to
                   its own bounds since #409 landed on 2026-08-29, and
                   that is precisely why the overflow is invisible rather
                   than spilling over the pane below it. What is missing
                   is a VIEWPORT: something that decides WHICH lines the
                   fixed cell shows. That is the pane-local viewport in
                   docs/specs/2026-08-23-scrolling.md (issue #67), real
                   work and correctly out of scope for the cheap version.

                   The distinction is worth keeping straight, because a
                   reader who believes there is no clipping will look for
                   the wrong bug: they will expect to SEE the extra lines
                   somewhere. -->
              <!-- NO Style, and that is deliberate rather than an omission.
                   dim is what this page uses for secondary chrome — hints,
                   the fit message, the "designer is the centre pane" note —
                   and a pane whose whole purpose is reading prose is not
                   chrome. Reading architecture.md at reduced contrast works
                   against the feature. Found in review of #426.

                   The empty-state messages come back through this same
                   <Text>, so they lose the dim too; one string cannot carry
                   two styles, and the primary content is the one to get the
                   readable one. -->
              <Text Grid.Row="1">{{.DocsBody}}</Text>
            </Grid>
          </Tab>

          </Tabs>
        </Panel>
      </DockPane>

      <!-- THE EDITOR REGION, and this is the region swap.

           Code is NOT a panel sharing the bottom strip with diagnostics.
           It is THE SAME REGION showing something else, which is why
           both children sit in one Grid cell with opposite Visibility
           bindings rather than in two cells side by side. Exactly one is
           Visible; the other is Collapsed and occupies nothing.

           DesignChecked and CodeChecked are COMPUTEDS over one source
           property, ed.region — so the two can never both be on, and the
           menu's check marks, this swap and ctrl+backslash are three
           renderings of one state rather than three states.

           THE MULTI-LINE EDITOR THIS FRAMEWORK DOES NOT HAVE: <TextBox>
           is single-line, and there is no multi-line text component in
           components/ at all. So the CODE region is READ-ONLY — a <Text>
           showing the same serialisation the OUTPUT tab shows. That is
           stated rather than disguised: the region swap, the menus, the
           check state and the accelerators are all real and all work;
           what is missing is the ability to TYPE into the code view, and
           the honest route to it today is $EDITOR, which is why that
           item exists and actually launches. -->
      <DockPane Id="editor" Title="EDITOR" Slot="Center">
        <!-- TWO CHILDREN, OVERLAID, and no wrapper between them and the
             pane. A <DockPane> arranges every child into the same body
             rect, so the two views share one region by construction —
             which is what "the same region showing something else"
             means — and exactly one is Visible because the two bindings
             are complementary computeds over one property.

             The wrapper <Grid Rows="1*" Cols="1*"> that used to sit here
             was removed for a MEASURED reason, not a tidiness one: a
             drag motion in the designer repaints the ancestor chain
             above the moved element (Composer.restoreUnder force-repaints
             what the vacated rect uncovered), so one extra level between
             the dock and the design surface cost one extra component
             repainted on every single pointer report. It was the
             difference between 9 and drag_test.go's ceiling of 8. -->
        <Panel Name="EditorArea" Pad="1" Visibility="{{.DesignChecked}}">
          <Preview Name="Island"/>
        </Panel>
        <Panel Name="CodeArea" Pad="1" Visibility="{{.CodeChecked}}">
          <Text Style="dim">{{.Source}}</Text>
        </Panel>
      </DockPane>

      <DockPane Id="properties" Title="PROPERTIES" Slot="Right" Size="46">
        <Panel Name="Properties" Style="dim">
          <!-- A GRID WITH DECLARED TRACKS, NOT A VSTACK — and this is a bug fix,
               not a preference.
               As a VStack this pane could not be edited at all. A VStack sizes
               each child by what it measures, ItemsView measures greedily, and
               so the list took all 41 rows and the edit row underneath it was
               arranged at W:0 H:0 on a row past the bottom of the panel. The
               mechanism worked perfectly — a keystroke dispatched to that
               TextBox did change the attribute — but the input was invisible and
               unclickable, so "I can't modify values" was exactly right.
               Only the LIST is elastic. Everything else is a fixed track that
               gets its rows before the star is resolved, which is the same rule
               an adornment row follows: a row that must exist has to be
               declared, because a container with a greedy sibling will not
               leave it anything. -->
          <!-- TWO TRACKS NOW, NOT FOUR, AND THE EDITOR IS IN NEITHER.
               The list still gets the only star track, for the reason the
               comment above gives — a greedy ItemsView beside a plain sibling
               leaves that sibling nothing, which is how the old input came to
               be arranged at W:0 H:0 below the panel. What changed is that the
               editor is no longer a sibling competing for rows: <ValueEditor>
               occupies the SAME cell as the list and places its overlays by
               explicit geometry, over the row they belong to. There is no
               track to lose. -->
          <Grid Rows="1,1*,2" Cols="1*">
            <!-- Same rule as the toolbox: these widths are the row template's
                 widths. The lead column is one cell wide and unlabelled because
                 its header would be the glyph itself, and the one beside TYPE
                 carries the editor affordance — Visual Studio's "…" and "▾". -->
            <HStack Grid.Row="0" Gap="1">
              <Text Width="1" Style="sel"> </Text>
              <Text Width="13" Style="sel">ATTRIBUTE</Text>
              <Text Width="8" Style="sel">TYPE</Text>
              <Text Width="1" Style="sel"> </Text>
              <Text Style="sel">VALUE</Text>
            </HStack>
            <!-- THE EDITING SURFACE. It takes exactly two children: the list
                 it floats over, and the TextBox its caret editor uses. Both
                 stay here rather than being built in Go because both carry
                 bindings, and a binding written in Go is a binding nobody can
                 see from the page. What the component supplies is the geometry
                 and the keyboard — the parts markup cannot say. -->
            <ValueEditor Grid.Row="1">
              <!-- Mark is the modified-from-default column: "•" where the
                   document's value differs from the declared default. More is
                   the editor affordance, derived from the attribute's Kind
                   through the per-Kind table in editors.go. Rows arrive
                   grouped by markup.CategoryOf. -->
              <ItemsView Items="{{.AttrItems}}" Selected="{{.AttrSel}}"
                         Activate="{{.BeginEdit}}">
                <ItemsView.ItemTemplate>
                  <HStack Gap="1">
                    <Text Width="1" Style="sel">{{.Mark}}</Text>
                    <Text Width="13">{{.Name}}</Text>
                    <Text Width="8" Style="dim">{{.Kind}}</Text>
                    <Text Width="1" Style="warn">{{.More}}</Text>
                    <Text Style="ok">{{.Value}}</Text>
                  </HStack>
                </ItemsView.ItemTemplate>
              </ItemsView>
              <!-- THE CARET EDITOR, floated over the selected row's value
                   cell. Changed fires on every keystroke, so the document
                   follows the key rather than waiting for enter — which is
                   what makes editing a Grid track spec beside a drawn grid
                   worth doing at all. -->
              <TextBox Text="{{.EditValue}}" Changed="{{.CommitEdit}}"/>
            </ValueEditor>
            <!-- The description line. The catalog's Doc is empty on most
                 attributes today, so the editor sends legal values instead and
                 will send prose the moment Doc is populated. -->
            <Text Grid.Row="2" Style="dim">{{.EditDoc}}</Text>
          </Grid>
        </Panel>
      </DockPane>

      <DockPane Id="panel" Title="PANEL" Slot="Bottom" Size="10" Pinned="false">
        <Panel Name="Output" Style="dim">
          <Tabs Name="PanelTabs">
            <!-- PROBLEMS is first, as it is in VS Code: FitMsg is what the fit
                 watcher says about the current terminal size, which is the one
                 diagnostic this editor produces about itself. -->
            <Tab Header="PROBLEMS">
              <Text Style="dim">{{.FitMsg}}</Text>
            </Tab>
            <Tab Header="OUTPUT">
              <Text Style="dim">{{.Source}}</Text>
            </Tab>
          </Tabs>
        </Panel>
      </DockPane>

    </DockHost>

    <StatusBar Name="StatusBar" Grid.Row="2" Grid.Col="0" Grid.ColSpan="4"
               Left="{{.Status}}" Center="{{.ModeText}}">
      <!-- Right is a SLOT, not the Right="{{.Serving}}" attribute it was:
           the addresses are one clickable chip each, so a click can land
           on one of them instead of on a twenty-character string. Each
           chip keeps its own paint node, which is what makes a copy flash
           repaint that chip and leave the mode indicator and the build
           status alone. See statusaddr.go — including why the strip falls
           back to the plain {{.Serving}} text when no endpoint came up,
           so the "no control plane" message is unchanged. -->
      <StatusBar.Right><ServeAddrs/></StatusBar.Right>
    </StatusBar>

    <!-- THE MENUS, declared LAST for z-order and placed on row 0 by
         Grid.Row — the two are independent, which is exactly what an
         overlay needs.

         VIEW → CODE IS FLATTENED, and that is a framework limit stated
         rather than worked around: components.Menu is ONE level (Menu →
         []MenuItem) and buildMenuBar rejects anything but <MenuItem>
         inside a <Menu>, so "View → Code → [x] Built in" becomes a
         labelled group between separators. Inventing nesting here would
         mean inventing it in the framework first.

         EVERY Checked= BINDS A COMPUTED over one source property, and
         every Command= is the SAME gooey.Action value the matching
         KeyBinding above resolves. That is what makes "the accelerator
         toggles the same state the check shows" true by construction:
         there is one state and one action, rendered and reachable twice.

         The Gesture= strings are DISPLAY HINTS — showing one does not
         bind it — so each is the canonical spelling of the KeyBinding
         that does, and markup validates them through input.ParseGesture
         at load. -->
    <MenuBar Name="Menus" Grid.Row="0" Grid.Col="0" Grid.ColSpan="2" Style="dim">

      <Menu Title="_File">
        <MenuItem Text="_Open Folder…" Gesture="ctrl+o" Command="{{.OpenFolder}}"/>
        <MenuItem Text="Open _File" Command="{{.OpenFile}}"/>
        <MenuItem Separator="true"/>
        <!-- SAVE IS REAL, and it serialises the DOCUMENT MODEL rather
             than the live tree. That is the hazard rather than a
             preference: the tree on screen is what markup.Build made of
             the document PLUS whatever patch_markup put there, and
             writing the tree would save those patches into the user's
             file as if they had authored them.

             It is CONDITIONAL, not always-on. gooey.NewCommand(..).When
             makes the item dim until a file from a real directory is
             open, and MenuBar reads CanExecute while painting — so it
             un-dims the moment one is, with no event anywhere. A greyed
             Save is honest; one that silently does nothing is not. -->
        <MenuItem Text="_Save" Gesture="ctrl+s" Command="{{.Save}}"/>
        <MenuItem Separator="true"/>
        <MenuItem Text="E_xit" Gesture="q" Command="{{.Quit}}"/>
      </Menu>

      <Menu Title="_Project">
        <!-- REFRESH IS EXPLICIT because there is NO directory watcher,
             and that is a decision recorded in browser.go: Content.Watch
             reports only THAT the source changed, never the new tree,
             because the rebuild has to happen on the UI goroutine — and
             a workspace makes building it on the watcher's goroutine the
             easy mistake. A snapshot you can see and refresh beats a
             watcher that silently misses the write racing its own
             baseline. -->
        <MenuItem Text="_Refresh Files" Command="{{.Refresh}}"/>
        <MenuItem Separator="true"/>
        <MenuItem Text="_Close Folder" Command="{{.CloseFolder}}"/>
      </Menu>

      <Menu Title="_View">
        <!-- THE REGION, as a radio pair over one property. -->
        <MenuItem Text="_Design" Checked="{{.DesignChecked}}" Command="{{.ShowDesign}}"/>
        <MenuItem Text="_Code" Gesture="ctrl+\" Checked="{{.CodeChecked}}" Command="{{.ShowCode}}"/>
        <MenuItem Separator="true"/>
        <!-- CODE → which viewer. The specified submenu, flattened.

             "$EDITOR" alone tells you nothing about what will open, so
             the label carries the RESOLVED program — "$EDITOR (nvim)" —
             and reads "$EDITOR (unset)" when the variable is empty. The
             item is also disabled in that case, and when there is no
             file for it to open, so the menu dims it rather than
             offering a key that fails. -->
        <MenuItem Text="_Built in" Gesture="ctrl+b" Checked="{{.BuiltinChecked}}" Command="{{.UseBuiltin}}"/>
        <MenuItem Text="{{.EditorItemText}}" Gesture="alt+e" Checked="{{.EditorChecked}}" Command="{{.UseEditor}}"/>
        <MenuItem Separator="true"/>
        <!-- THE DOCK, from the menu. Same actions as the KeyBindings. -->
        <MenuItem Text="Ne_xt Pane" Gesture="ctrl+alt+right" Command="{{.NextPane}}"/>
        <MenuItem Text="_Hide Pane" Gesture="ctrl+w" Command="{{.TogglePane}}"/>
        <MenuItem Text="Co_llapse Pane" Gesture="ctrl+r" Command="{{.CollapsePane}}"/>
        <MenuItem Text="_Pin Pane" Gesture="ctrl+alt+p" Command="{{.PinPane}}"/>
        <MenuItem Text="Hide _Unpinned" Gesture="ctrl+f" Command="{{.HideUnpinned}}"/>
        <MenuItem Text="Show _All Panes" Gesture="ctrl+a" Command="{{.ShowAllPanes}}"/>
      </Menu>

    </MenuBar>
  </Grid>
</Gooey>
