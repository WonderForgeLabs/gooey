# Either works — the Claude Agent SDK shells out to the `claude` CLI, which
# resolves credentials the same way `claude` itself does (ANTHROPIC_API_KEY,
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`, or an active `claude
# auth login` session all work; no env var needed if you're already logged in).
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_TASK_QUEUE=gooey-dynamic-ui-task-queue
GOOEY_MCP_URL=http://127.0.0.1:7777/mcp
