<Gooey xmlns="wonderforge.io/gooey/2026">
  <Grid Rows="Auto,*,Auto,Auto">
    <HStack Grid.Row="0" Gap="1">
      <Text Style="dim">new task:</Text>
      <TextBox Name="NewTitle" Text="{{.NewTitle}}" Prompt="&gt; " AccentStyle="accent"/>
      <Button Name="AddBtn" Content="Add" Click="{{.AddTask}}"/>
      <KeyBinding Gesture="enter" Command="{{.AddTask}}"/>
    </HStack>

    <Grid Grid.Row="1" Cols="*,*,*">
      <Border Grid.Col="0" Title="Todo" Style="panel">
        <Grid Rows="*,Auto">
          <ItemsView Name="TodoList" Grid.Row="0" Items="{{.TodoItems}}" Selected="{{.TodoSel}}">
            <ItemsView.ItemTemplate>
              <Text>{{.Title}}</Text>
            </ItemsView.ItemTemplate>
          </ItemsView>
          <HStack Grid.Row="1" Gap="1">
            <Button Name="TodoMoveRightBtn" Content="Move →" Click="{{.TodoMoveRight}}"/>
            <Button Name="TodoRemoveBtn" Content="Remove" Click="{{.TodoRemove}}"/>
          </HStack>
        </Grid>
      </Border>

      <Border Grid.Col="1" Title="Doing" Style="panel">
        <Grid Rows="*,Auto">
          <ItemsView Name="DoingList" Grid.Row="0" Items="{{.DoingItems}}" Selected="{{.DoingSel}}">
            <ItemsView.ItemTemplate>
              <Text>{{.Title}}</Text>
            </ItemsView.ItemTemplate>
          </ItemsView>
          <HStack Grid.Row="1" Gap="1">
            <Button Name="DoingMoveLeftBtn" Content="← Move" Click="{{.DoingMoveLeft}}"/>
            <Button Name="DoingMoveRightBtn" Content="Move →" Click="{{.DoingMoveRight}}"/>
            <Button Name="DoingRemoveBtn" Content="Remove" Click="{{.DoingRemove}}"/>
          </HStack>
        </Grid>
      </Border>

      <Border Grid.Col="2" Title="Done" Style="panel">
        <Grid Rows="*,Auto">
          <ItemsView Name="DoneList" Grid.Row="0" Items="{{.DoneItems}}" Selected="{{.DoneSel}}">
            <ItemsView.ItemTemplate>
              <Text>{{.Title}}</Text>
            </ItemsView.ItemTemplate>
          </ItemsView>
          <HStack Grid.Row="1" Gap="1">
            <Button Name="DoneMoveLeftBtn" Content="← Move" Click="{{.DoneMoveLeft}}"/>
            <Button Name="DoneRemoveBtn" Content="Remove" Click="{{.DoneRemove}}"/>
          </HStack>
        </Grid>
      </Border>
    </Grid>

    <Tabs Grid.Row="2" Name="PanelTabs" Selected="{{.ActiveTab}}" Changed="{{.TabChanged}}">
      <Tab Header="mcp">
        <!-- Height matches LogPanel's: a Tabs sizes to its ACTIVE page,
             so equal page heights keep the strip from moving on switch. -->
        <Border Title="mcp" Style="panel" Height="12">
          <Text Name="Help" Margin="1,0" Style="dim">{{.Help}}</Text>
        </Border>
      </Tab>
      <Tab Header="log">
        <LogPanel Name="LogPanel" Height="12"/>
      </Tab>
    </Tabs>

    <!-- The bottom row is a StatusBar rather than one dim Text with the
         gaps counted by hand: navigation against the left edge, the
         primary action in the middle, mode and exit against the right.
         Each section is its own paint node, so a hint that later becomes
         bound (a card count, a worker state) repaints alone.

         The wording is shorter than the Text it replaces because the old
         one did not fit. That Text asked for 115 columns on a board whose
         three panels are comfortable near 100, so its tail — "q: quit" —
         was clipped off the right edge with nothing to say so. StatusBar
         does not shorten the row by itself; what it changes is WHICH end
         gives way, because the edges hold and the centre shortens. Saying
         less is the actual fix, and there is less to say: the field above
         is already labelled "new task:", and the tab strip above already
         reads "mcp | log". -->
    <StatusBar Grid.Row="3"
               Left="tab: move focus   ↑/↓ or j/k: select a card"
               Center="enter: add task"
               Right="ctrl+t: switch tabs   q: quit"/>

    <KeyBinding Gesture="q" Command="{{.Quit}}"/>
    <KeyBinding Gesture="ctrl+c" Command="{{.Quit}}"/>
    <KeyBinding Gesture="ctrl+t" Command="{{.ToggleTab}}"/>
  </Grid>
</Gooey>
