# Built executables. `go build ./...` writes one file per main package into
# the CURRENT directory, so a main package's binary lands at the root of ITS
# OWN module — not at the repo root. Every entry below is therefore
# <module-dir>/<package-dir-name>, and the repo-root entries are just the
# root module's share of that rule.
#
# THIS BLOCK IS GENERATED, NOT HAND-MAINTAINED. Regenerate it after adding,
# renaming or removing any main package — a hand-edit is how it came to list
# 18 entries (two of which, /mcpdemo and /temporaldemo, named paths no build
# has ever produced) against 38 real main packages, leaving 22 binaries free
# to ride into a `git add -A` — all ten docs/learn/examples/* ones among them:
#
#   find . -mindepth 1 -name '.?*' -prune -o -name go.mod -print | sort |
#   while IFS= read -r mod; do
#     m=${mod%/go.mod}; rel=${m#./}; [ "$rel" = "." ] && rel=
#     go -C "$m" list -f '{{if eq .Name "main"}}{{.Dir}}{{end}}' ./... |
#     while IFS= read -r d; do
#       [ -n "$d" ] || continue
#       printf '/%s%s\n' "${rel:+$rel/}" "$(basename "$d")"
#     done
#   done | sort -u
#
# Discovering the modules rather than listing them is the same rule CI's
# discover job and CLAUDE.md's Verify loop follow, and for the same reason: a
# written list of modules is stale the first time someone adds one.
